<service>
  <id>PrintRocketClient</id>
  <name>PrintRocket - Cliente de Impresión ERP</name>
  <description>Recibe tickets del Supabase del negocio y los imprime por USB.</description>
  <executable>%BASE%\node.exe</executable>
  <arguments>%BASE%\src\index.js</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <env name="PRINTROCKET_CONFIG" value="%PROGRAMDATA%\PrintRocket\config.json" />
  <logpath>%PROGRAMDATA%\PrintRocket\logs</logpath>
  <log mode="roll" />
  <onfailure action="restart" delay="5 sec" />
  <resetfailure>1 hour</resetfailure>
</service>
